{
  "id": "files",
  "version": "2.0.0",
  "kind": "process",
  "description": "文件工具（read/write/edit/grep/glob/upload/download）",
  "messageTypes": [
    "file_read",
    "file_write",
    "file_edit",
    "file_grep",
    "file_glob",
    "file_upload_start",
    "file_download_start"
  ],
  "needsIO": true,
  "hooks": {
    "handle_message": {}
  },
  "permissions": {
    "required": [
      "session.read",
      "filesystem.read",
      "filesystem.write",
      "filesystem.execute"
    ]
  },
  "config": {
    "defaults": {
      "max_read_size": 262144,
      "default_read_limit": 2000,
      "max_line_length": 2000,
      "max_path_len": 4096,
      "max_content_len": 1048576,
      "max_grep_matches": 100,
      "max_glob_files": 100,
      "rg_exe": "",
      "ignored_dirs": [
        ".git",
        ".opencode",
        ".idea",
        ".vscode",
        "node_modules",
        "vendor",
        "dist",
        "build",
        "target",
        "__pycache__",
        "bin",
        "obj",
        "out",
        "coverage",
        "logs",
        "generated"
      ]
    }
  }
}
